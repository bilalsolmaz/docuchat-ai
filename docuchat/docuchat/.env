# ─────────────────────────────────────────
#  DocuChat — Ortam Değişkenleri
# ─────────────────────────────────────────
# Bu dosyayı .env olarak kopyalayın:
#   cp .env.example .env
# Ardından OPENAI_API_KEY değerini girin.

# OpenAI API anahtarınız (zorunlu)
# https://platform.openai.com/api-keys adresinden alabilirsiniz
OPENAI_API_KEY=buraya_api_anahtarinizi_girin

# Kullanılacak model (varsayılan: gpt-4o-mini — ekonomik ve hızlı)
CHAT_MODEL=gpt-4o-mini

# Embedding modeli (değiştirmenize gerek yok)
EMBEDDING_MODEL=text-embedding-3-small

# Chunk ayarları
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Her sorgu için kaç chunk alınacak
TOP_K=5
